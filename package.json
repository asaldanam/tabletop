{
    "name": "tabletop",
    "private": true,
    "type": "module",
    "version": "0.0.1",
    "packageManager": "npm@10.9.2",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "turbo dev ts:watch",
        "build": "npm --workspace main run build",
        "preview": "turbo preview",
        "cf:preview": "turbo cf:preview",
        "cf:deploy": "npm run build && npm --workspace main run cf:deploy"
    },
    "devDependencies": {
        "turbo": "2.6.1"
    }
}