{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tabletop",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-06-07",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  }
}
