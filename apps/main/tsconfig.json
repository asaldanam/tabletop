{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@core": [
        "../../packages/core/src/index.ts"
      ],
      "@core/*": [
        "../../packages/core/src/*"
      ]
    },
    "types": [
      "node"
    ]
  }
}
