---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

const renderedAt = new Date().toISOString();
const requestPath = Astro.url.pathname;
---

<Layout
	title="Pricing | Tabletop"
	description="Example of an Astro route rendered on demand through the Cloudflare adapter."
>
	<section class="mx-auto flex min-h-[100svh] max-w-5xl flex-col justify-center px-6 py-16">
		<div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr]">
			<div class="space-y-5">
				<p class="text-xs font-semibold uppercase tracking-[0.35em] text-cyan-300">
					Server-rendered route
				</p>
				<h1 class="text-5xl leading-none text-white sm:text-6xl">`/pricing` sale desde el Worker.</h1>
				<p class="max-w-2xl text-lg leading-8 text-slate-300">
					Esta página exporta <code>prerender = false</code>, así que Astro la renderiza on demand
					mientras el resto del proyecto puede seguir estático.
				</p>
				<a
					class="inline-flex rounded-full border border-white/15 px-5 py-3 text-sm font-semibold text-white transition hover:border-cyan-300 hover:text-cyan-200"
					href="/tabletop/nested/route"
				>
					Probar una deep link de la SPA
				</a>
			</div>

			<div class="rounded-[2rem] border border-white/10 bg-white/5 p-6 shadow-2xl shadow-slate-950/40 backdrop-blur">
				<p class="text-sm font-semibold uppercase tracking-[0.28em] text-slate-400">Diagnóstico SSR</p>
				<dl class="mt-5 space-y-4 text-sm text-slate-200">
					<div>
						<dt class="text-slate-400">Renderizado en</dt>
						<dd class="mt-1 font-medium text-white">{renderedAt}</dd>
					</div>
					<div>
						<dt class="text-slate-400">Ruta servida</dt>
						<dd class="mt-1 font-medium text-white">{requestPath}</dd>
					</div>
					<div>
						<dt class="text-slate-400">Modo</dt>
						<dd class="mt-1 font-medium text-white">Static output con rutas puntuales SSR</dd>
					</div>
				</dl>
			</div>
		</div>
	</section>
</Layout>
