{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".astro/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    },
    "cf:preview": {
      "cache": false,
      "persistent": true
    },
    "cf:deploy": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "astro": {
      "cache": false
    }
  }
}
