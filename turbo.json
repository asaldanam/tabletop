{
    "$schema": "https://turbo.build/schema.json",
    "ui": "stream",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**",
                ".astro/**"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "ts:watch": {
            "cache": false,
            "dependsOn": [
                "^ts:watch"
            ]
        },
        "preview": {
            "dependsOn": [
                "build"
            ],
            "cache": false,
            "persistent": true
        },
        "cf:preview": {
            "cache": false,
            "persistent": true
        },
        "cf:deploy": {
            "dependsOn": [
                "build"
            ],
            "cache": false
        },
        "astro": {
            "cache": false
        }
    }
}
